@model List<OnLineShop2026.Models.User>

<h1>Пользователи</h1>

<table class="table">
    <thead>
        <tr>
            <th>Аватар</th>
            <th>Имя</th>
            <th>Фамилия</th>
            <th>Email</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var user in Model)
        {
            <tr onclick="location.href='/User/Details?userId=@user.UserId'"
                style="cursor:pointer">

                <td>
                    <img src="@user.Icon"
                         width="70"
                         height="70" />
                </td>

                <td>
                    @user.Name
                </td>

                <td>
                    @user.Surname
                </td>

                <td>
                    @user.Email
                </td>

            </tr>
        }

    </tbody>
</table>