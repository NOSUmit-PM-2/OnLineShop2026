@model List<Product>
@{
    ViewData["Title"] = "Каталог";
}
<h1>Каталог</h1>
<div class="search-form" style="margin-bottom: 20px;">
    <form method="post" asp-action="Catalog">
        <label for="maxPrice">Максимальная цена:</label>
        <input type="number"
               id="maxPrice"
               name="maxPrice"
               step="0.01"
               placeholder="Введите максимальную цену" />
        <button type="submit">Поиск</button>
    </form>
</div>
<div style="margin-bottom: 20px;">
    <a asp-action="Catalog">Показать все товары</a>
</div>

<div class="row">
    @foreach (var product in @Model)
    {
        <div class="card" style="width: 18rem;">
            <img src="@product.PathImage" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">@product.Name</h5>
                <p class="card-text">@product.Description</p>
                <p class="card-subtitle">@product.Cost р.</p>
                <p class="card-text">@product.Id</p>
                <a asp-controller="product" asp-action="index" asp-route-id="@product.Id" class="btn btn-primary">Подробнее</a>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <p>Товары с ценой меньше указанной не найдены.</p>
}
