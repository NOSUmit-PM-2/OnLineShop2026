@model List<User>

@{
    ViewData["Title"] = "Пользователи";
}

<h2>Список пользователей</h2>

@if (Model != null && Model.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Email</th>
                <th>Имя</th>
                <th>Фамилия</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>

                    <td>
                        <a asp-controller="User"
                           asp-action="Index"
                           asp-route-id="@Model[i].Id">
                            @Model[i].Email
                        </a>
                    </td>

                    <td>@Model[i].Name</td>
                    <td>@Model[i].LastName</td>

                    <td>
                        <a asp-controller="User"
                           asp-action="Index"
                           asp-route-id="@Model[i].Id">
                            Подробнее
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p>Всего пользователей: @Model.Count</p>
}
else
{
    <p>Пользователей нет</p>
}