@model List<Product>
@{
    ViewData["Title"] = "Каталог";
}
<h1>Каталог</h1>
<div class="row">

    @using (Html.BeginForm("Catalog", "Home", FormMethod.Get))
    {
    <div style="margin-bottom: 15px;">
            <input type="text"
               name="searchString"
               value="@ViewBag.SearchString"
               placeholder="Поиск по названию..." />
        <button type="submit">Поиск</button>
    </div>
    }



    @foreach(var product in @Model)
    {
        <div class="card" style="width: 18rem;">
            <img src="@product.PathImage" class="card-img-top" alt="...">
            <div class="card-body">
                <h5 class="card-title">@product.Name</h5>
                <p class="card-text">@product.Description</p>
                <p class="card-subtitle">@product.Cost р.</p>
                <p class="card-text">@product.Id</p>
                <!--  <a href="/product/index/@product.Id" class="btn btn-primary">Подробнее</a> -->
                <a asp-controller = "product" asp-action="index" asp-route-id = "@product.Id" class="btn btn-primary">Подробнее</a>
            </div>
        </div>
    }
</div>
